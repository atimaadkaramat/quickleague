{
  "appId": "com.atimaadkaramat.quickleague",
  "productName": "QuickLeague",
  "copyright": "Copyright © 2026 atimaadkaramat",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*",
    "package.json"
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "portable": {
    "artifactName": "QuickLeague-Portable-${version}.exe"
  }
}
